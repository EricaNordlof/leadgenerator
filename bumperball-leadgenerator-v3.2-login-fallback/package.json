{
  "name": "bumperball-leadgenerator-v3",
  "version": "3.2.0",
  "private": true,
  "description": "Produktionsklar leadgenerator för Offroad Bumpis med inloggning, PostgreSQL, automatisk leadinsamling, Gmail-utkast och bokningskoppling.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "discover": "node scripts/discover.js",
    "trigger-discovery": "node scripts/trigger-discovery.js",
    "test": "node --test",
    "check": "node --check server.js && node --check public/app.js && node --check src/routes.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "connect-pg-simple": "^10.0.0",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.1",
    "express-session": "^1.18.2",
    "googleapis": "^173.0.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "zod": "^4.0.0"
  }
}
